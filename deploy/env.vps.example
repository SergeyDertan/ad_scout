# .env for the VPS — copy to /opt/adscout/.env and fill the three PLACEHOLDERs.
#
#   sudo -u adscout -H cp /opt/adscout/deploy/env.vps.example /opt/adscout/.env
#   sudo -u adscout -H nano /opt/adscout/.env
#   sudo chmod 600 /opt/adscout/.env
#
# This is the SERVER half. The Mac keeps a different, much smaller .env — it runs
# only `pnpm remote:worker` (see docs/VPS-DEPLOY.md §9) and must never be given a
# real store or client_secret.json (§11).
#
# The full annotated list of every variable is .env.example at the repo root.
# This file is only the subset a live host needs, with the values that are right
# for THIS deployment.

# --- store -------------------------------------------------------------------
STORE=pouchdb
POUCH_DIR=./data/pouch

# --- email -------------------------------------------------------------------
# A TWO-STATE SWITCH, not a transport name: unset or "dummy" means nothing is
# really sent. Which transport an account uses is decided per account by its
# providerType — but that router is only wired up when the Google OAuth client
# is present. All three mailboxes here are gmail-api, so client_secret.json in
# /opt/adscout is MANDATORY: without it they silently fall back to SMTP, have no
# app password, and every send fails.
EMAIL_PROVIDER=smtp-imap

# --- llm ---------------------------------------------------------------------
# Extraction is delegated to the Mac's worker through the hub below; this value
# is what a MANUAL poll pass would use on the box. Deliberately not "dummy":
# DummyLlmProvider stubs extraction, so a stray manual run would write invented
# offers into real targets. claude-code has no CLI here and fails loudly, which
# is the behaviour you want.
LLM_PROVIDER=claude-code
CLAUDE_CODE_MODEL=claude-sonnet-5

# --- clock -------------------------------------------------------------------
# Authoritative regardless of the host's zone, and validated at boot: an unknown
# name or a value that did not take effect is fatal. Do NOT leave it blank —
# Node reads "" as Etc/Unknown, which is UTC in disguise, and the whole send
# window would shift silently.
TZ=Europe/Kyiv
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=18

# --- binding -----------------------------------------------------------------
# Loopback only. nginx proxies over 127.0.0.1 and the worker's SSH tunnel
# terminates there, so nothing legitimate needs an external interface. Without
# this Node binds every interface and the firewall becomes the only thing
# between the extraction hub and the internet.
BIND_HOST=127.0.0.1

# --- extraction hub ----------------------------------------------------------
# REUSE the token already in the Mac's .env — do not generate a new one, or the
# worker stops matching. The hub refuses to start without it rather than
# publishing a writable endpoint naked.
REMOTE_TOKEN=PLACEHOLDER_SAME_TOKEN_AS_THE_MAC
REMOTE_PORT=8788
REMOTE_HUB=on
# The CLI default of 1 would stop handing out work after a single failed reply.
REMOTE_MAX_FAILED=10

# --- who may use the API -----------------------------------------------------
# Setting EITHER list turns authentication on. Both empty means NO auth at all —
# correct on a laptop's loopback, catastrophic here. Must be verified GOOGLE
# accounts; sign-in is Google-only.
#   ADMIN_EMAILS    the operator: everything.
#   MANAGER_EMAILS  viewer + deal manager: reads all, runs the negotiation, but
#                   cannot import, touch mailboxes or start a send pass.
ADMIN_EMAILS=PLACEHOLDER_YOUR_GOOGLE_ADDRESS
MANAGER_EMAILS=
FIREBASE_PROJECT_ID=postwormhole

# --- logs --------------------------------------------------------------------
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# --- backups -----------------------------------------------------------------
# Hourly, taken inside the server under the same write lock the pipeline uses,
# and verified against its own manifest before it counts. Today stays at hourly
# resolution; every earlier day collapses to its newest archive; anything past
# BACKUP_KEEP_DAYS goes.
#
# THE ARCHIVES CONTAIN EVERY MAILBOX'S OAUTH REFRESH TOKEN IN THE CLEAR. Treat
# them, and any bucket they are mirrored to, as mailbox credentials.
BACKUP=on
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_PREFIX=backups
# Offsite mirror, same retention rule applied there. Needs a service account.
# BACKUP_BUCKET=
# BACKUP_CREDENTIALS=./firebase-service-account.json

# --- viewer snapshots (optional) ---------------------------------------------
# Only if you publish the read-only price viewer. Empty bucket = disabled.
SNAPSHOT_BUCKET=
# SNAPSHOT_CREDENTIALS=./firebase-service-account.json
