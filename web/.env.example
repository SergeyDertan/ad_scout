# Front-end build settings.
#
# The Firebase web config is NO LONGER here — it is hardcoded in
# web/src/viewer/firebase.ts. There is one project, it never changes, and none of
# those values are secrets; keeping them in a build-time env file only meant a
# host that required sign-in failed with auth/invalid-api-key when nobody had
# thought to create web/.env.local.
#
# A service-account key IS a secret and must never appear in this file or any
# other VITE_ variable: they are compiled into the public bundle.

# Must match SNAPSHOT_PREFIX in the root .env.
VITE_SNAPSHOT_PREFIX=snapshot

# Point the dashboard at an API on a different origin. Leave unset when the same
# server serves both, which is the case on the VPS.
# VITE_API_ORIGIN=
