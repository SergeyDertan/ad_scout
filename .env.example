# AdScout — environment configuration (copy to .env; .env is gitignored)
# Secrets are referenced by Account.credentialRef = the env var NAME below.

# --- Sending account credentials (one block per account; the NAME is the credentialRef) ---
# Format: <CREDENTIAL_REF>_USER / <CREDENTIAL_REF>_PASS for SMTP/IMAP app passwords.
# Optional per-account host overrides: <REF>_HOST (default "gmail"),
#   <REF>_SMTP_HOST/_SMTP_PORT (default 465), <REF>_IMAP_HOST/_IMAP_PORT (default 993).
#
# Personal Gmail with an APP PASSWORD (recommended; turn on 2FA, then create one
# at https://myaccount.google.com/apppasswords). Set EMAIL_PROVIDER=smtp-imap below.
# The UI assigns a new Gmail account the credentialRef "GMAIL_<LOCALPART>", e.g.
# adding outreach@gmail.com → credentialRef GMAIL_OUTREACH → set:
# GMAIL_OUTREACH_USER=outreach@gmail.com
# GMAIL_OUTREACH_PASS=abcd efgh ijkl mnop   # 16-char Gmail app password
#
# Example for an account whose credentialRef = "VLAD_GMAIL":
# VLAD_GMAIL_USER=vlad@gmail.com
# VLAD_GMAIL_PASS=app-password-here
#
# NOTE: there ARE two transports, and Account.providerType picks between them.
# buildAgent() (src/lib/factory.ts) wires a RoutingEmailProvider that sends a
# "gmail-api" account over OAuth and an "smtp-imap" one over an app password —
# but ONLY when GOOGLE_CLIENT_ID/SECRET (or client_secret.json) are present.
# Without them every account falls back to SMTP, including gmail-api accounts
# that have no app password, and every send fails. EMAIL_PROVIDER is a separate,
# two-state switch: see below.

# --- LLM provider selection (factory) ---
# LLM_PROVIDER=dummy | ollama | openai | claude | claude-code
LLM_PROVIDER=dummy

# Ollama (local). Candidate model tag (confirm at install): gemma4:26b-mlx
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b-mlx

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (uses official @anthropic-ai/sdk when installed)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Claude Code CLI (shells out to a locally-installed, logged-in `claude` —
# runs against your Pro/Max subscription usage instead of per-token API
# billing; requires `claude` on PATH and `claude login`, NOT an API key).
# Good fit for low-volume, non-latency-sensitive extraction like this pass.
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_TIMEOUT_MS=120000

# --- Remote extraction (a second machine's Claude subscription) ---
# `pnpm remote:hub` serves unextracted replies over HTTP; `pnpm remote:worker`
# on another machine claims them, runs its own `claude` CLI, and posts results
# back — the database stays on the hub. See docs/REMOTE-EXTRACTION.md.
#
# ON A SERVER THE ROLES FLIP. `pnpm serve` now mounts the hub itself (sharing the
# one write lock), so the VPS holds the database and the Mac — which is where the
# `claude` subscription lives — runs `pnpm remote:worker` and dials IN. The worker
# never listens on anything, so ngrok is no longer in the picture at all.
#
# REMOTE_TOKEN is the shared secret BOTH sides need. Unlike the one-shot CLI,
# `pnpm serve` will NOT invent one: a token that changed on every restart would
# lock the worker out silently. Unset here means the hub does not start, and the
# server logs an error saying so.
REMOTE_TOKEN=
# Worker only — the hub's public URL, e.g. https://adscout.example.com:8788
REMOTE_HUB_URL=
# The WORKER-facing port, the one you publish (default 8788). Separate from the
# dashboard's PORT (8787) so the two can be firewalled independently.
REMOTE_PORT=8788
# Set to off to run the server with no hub (nothing will be extracted).
REMOTE_HUB=on
# Replies that may burn every attempt before the hub stops handing out work.
# The CLI's default is 1 (right for a one-shot campaign, wrong for a server:
# the stop never clears, so one poison reply would end extraction until the next
# restart). Keep a backstop, but far enough out that only a systemic failure trips it.
REMOTE_MAX_FAILED=10

# --- Email provider selection ---
# A two-state switch, NOT a transport name: unset or "dummy" means nothing is
# really sent; any other value means real mail, with the transport chosen per
# account as described above. Leaving this unset on a live host is the failure
# where everything looks healthy and no mail leaves.
# EMAIL_PROVIDER=dummy | smtp-imap
EMAIL_PROVIDER=dummy

# --- Store selection ---
# "memory" is a throwaway store: fresh at boot, gone when the process stops.
# That is the right setting on any machine that is NOT the live host — see
# docs/VPS-DEPLOY.md §11. "pouchdb" persists to POUCH_DIR.
# STORE=memory | pouchdb
STORE=memory

# --- Demo fixtures ---
# SEED=demo populates a memory store with one account and two targets, so the
# dashboard is worth opening on a local run: `just dev-seed`. It REFUSES to boot
# with STORE=pouchdb or a live EMAIL_PROVIDER, so it can neither write to a real
# store nor mail a real person. Leave unset everywhere else.
# SEED=demo
POUCH_DIR=./data/pouch

# --- Sending window / pacing (local time, 24h) ---
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=18

# --- Follow-ups (no-reply bumps) ---
# Disabled by default. Set to true to re-enable; only initial sends go out while off.
FOLLOW_UPS_ENABLED=false

# --- Logging ---
# All logs are teed to a daily JSONL file (one JSON object per line) so failures
# that happen while unattended (e.g. laptop asleep overnight) survive a closed
# terminal. Files are pruned after LOG_RETENTION_DAYS. Set LOG_DIR=off to disable.
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# --- Database backups ---
# An hourly dump of the whole store, taken INSIDE the server (the CLI
# `pnpm data:dump` cannot run while it is up — PouchDB is single-writer) and
# under the same lock the pipeline passes take, so nothing lands mid-snapshot.
# ~1.7s on a 7,900-doc store, ~3.8 MB compressed.
#
# Retention needs no second job: today keeps every hourly, every earlier day
# collapses to its newest archive, and anything past BACKUP_KEEP_DAYS goes.
# Steady state is ~24 + 14 archives, about 140 MB.
BACKUP=on
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_MS=3600000
#
# Cloud Storage mirror — the same retention rule is applied to the bucket, so
# offsite matches on-box. Both must be set; there is no fallback. Mint the
# credential with deploy/provision-backup-sa.sh, which scopes it to this one
# bucket rather than handing out a project-wide key.
#
# NOTE: the archive contains every mailbox's OAuth refresh token in the clear.
# storage.rules denies browser reads across the whole bucket, so only the Admin
# SDK's service account can read `backups/` — treat that JSON, and any local
# copy of these archives, as mailbox credentials.
# BACKUP_BUCKET=
BACKUP_PREFIX=backups
# BACKUP_CREDENTIALS=./firebase-service-account.json

# --- Network binding ---
# Which interface the dashboard (PORT) and the hub (REMOTE_PORT) listen on.
# Unset = every interface, which is Node's default and right for a laptop.
#
# ON A PUBLIC HOST SET THIS TO 127.0.0.1. nginx reaches both servers over
# loopback anyway, and so does an SSH tunnel to the hub — so binding loopback
# costs nothing and makes a missing firewall rule harmless instead of
# publishing the dashboard and the hub to the whole internet.
# BIND_HOST=127.0.0.1

# --- API authentication (required before exposing this to the internet) ---
# Two roles, both comma- or space-separated lists of Google accounts. LEAVE BOTH
# EMPTY for local runs: empty means no authentication, which is right on a
# laptop's loopback and catastrophic on a public host. Setting either turns on
# ID-token verification for every /api route (see src/server/auth.ts).
#
# The condition is: signed in, email verified, email on a list. Changes take
# effect on restart.
#
# ADMIN    the operator. Everything: mailboxes, imports, send passes, deals.
ADMIN_EMAILS=
# MANAGER  viewer + deal manager. Reads everything and runs the negotiation —
#          opens threads, answers them, records placements — but cannot import
#          targets, cannot pause/delete/connect mailboxes, and cannot start a
#          send pass. An address on both lists is an admin.
MANAGER_EMAILS=
# The Firebase project whose Google sign-in mints those tokens — the one in
# .firebaserc. Verification needs only this project id (the signature is checked
# against Google's public certs), NOT firebase-service-account.json.
FIREBASE_PROJECT_ID=

# --- Front-end build ---
# Origin the built UI calls for its API. Empty = same origin, which is how the
# operator console is served by `pnpm serve`. Set it only for a front-end hosted
# somewhere else (Firebase Hosting) talking to the VPS.
# VITE_API_ORIGIN=https://adscout.example.com

# --- Timezone ---
# The send window and the daily-quota reset are LOCAL-CLOCK (scheduler/window.ts,
# domain/limits.ts). A VPS defaulting to UTC silently shifts both. Set this to
# your business hours' zone; the systemd unit sets it too.
TZ=Europe/Kyiv
