{
  "name": "adscout",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src web/src -name '*.test.ts')",
    "demo": "tsx src/index.ts",
    "sample:extract": "tsx src/scripts/sample-extract.ts",
    "verify:replies": "tsx src/scripts/verify-replies.ts",
    "verify:sends": "tsx src/scripts/verify-sends.ts",
    "fix:stuck-targets": "tsx src/scripts/fix-stuck-targets.ts",
    "fix:markdown-suppressions": "tsx src/scripts/fix-markdown-suppressions.ts",
    "reattribute:ambiguous": "tsx src/scripts/reattribute-ambiguous.ts",
    "correct:dj-sensitive": "tsx src/scripts/correct-dj-sensitive.ts",
    "backfill:currency": "tsx src/scripts/backfill-currency.ts",
    "backfill:account-id": "tsx src/scripts/backfill-account-id.ts",
    "backfill:terms": "tsx src/scripts/backfill-terms.ts",
    "reextract:broad-batch": "tsx src/scripts/reextract-broad-batch.ts",
    "purge:non-guest-offers": "tsx src/scripts/purge-non-guest-offers.ts",
    "assign:batch-ids": "tsx src/scripts/assign-batch-ids.ts",
    "reset:extractions": "tsx src/scripts/reset-extractions.ts",
    "reset:for-reingest": "tsx src/scripts/reset-for-reingest.ts",
    "fetch:only": "tsx src/scripts/fetch-only.ts",
    "accounts:pause": "tsx src/scripts/pause-accounts.ts",
    "reextract:stored": "tsx src/scripts/reextract-stored.ts",
    "remote:hub": "tsx src/scripts/remote-hub.ts",
    "remote:worker": "tsx src/scripts/remote-worker.ts",
    "refetch:replies": "tsx src/scripts/refetch-replies.ts",
    "backfill:replies": "tsx src/scripts/backfill-missing-replies.ts",
    "publish:snapshot": "tsx src/scripts/publish-snapshot.ts",
    "data:dump": "tsx src/scripts/data-dump.ts",
    "data:load": "tsx src/scripts/data-load.ts",
    "serve": "tsx src/serve.ts",
    "dev": "tsx watch src/serve.ts",
    "web:build": "pnpm --filter adscout-web build",
    "viewer:build": "pnpm --filter adscout-web build:viewer",
    "viewer:dev": "pnpm --filter adscout-web dev:viewer",
    "viewer:deploy": "pnpm viewer:build && firebase deploy --only hosting,storage,firestore:rules",
    "deploy:hosting": "pnpm viewer:build && firebase deploy --only hosting",
    "web:dev": "pnpm --filter adscout-web dev",
    "web:typecheck": "pnpm --filter adscout-web typecheck",
    "build": "pnpm --filter adscout-web build",
    "dev:all": "concurrently -n server,web -c blue,green 'pnpm dev' 'pnpm web:dev'"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.3.0",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.17",
    "node-html-markdown": "^2.0.0",
    "nodemailer": "^9.0.6",
    "pouchdb": "^9.0.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@types/pouchdb": "^6.4.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
