rules_version = '2';

// The only mutable state the viewer has: each viewer's OWN niche
// classification (which niches they consider sensitive).
//
// It is private per account — a viewer can read and write their own document
// and no one else's. Nothing here ever flows back into the pipeline; the
// operator's data is published one-way into Cloud Storage and is never read
// from Firestore.

service cloud.firestore {
  match /databases/{database}/documents {

    function viewers() {
      return [
        'themars0719@gmail.com',
        'superator2018@gmail.com'
      ];
    }

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in viewers();
    }

    match /viewers/{uid} {
      allow read, write: if allowed()
        && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
