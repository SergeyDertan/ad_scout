# Firebase config for the shared read-only viewer (VITE_TARGET=viewer builds).
# Copy to web/.env.local and fill in from:
#   Firebase console → Project settings → Your apps → Web app → SDK setup
#
# None of these are secrets — a web config identifies the project, it does not
# authorize anything. Access is decided by storage.rules / firestore.rules,
# which require a signed-in account on the allowlist. The service-account key
# (SNAPSHOT_CREDENTIALS in the root .env) IS a secret and must never appear here:
# anything with a VITE_ prefix is compiled into the public bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match SNAPSHOT_PREFIX in the root .env.
VITE_SNAPSHOT_PREFIX=snapshot
