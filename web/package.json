{
  "name": "adscout-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AdScout operator console — React + Chakra UI front-end (a separate module from the server).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:viewer": "VITE_TARGET=viewer vite build",
    "dev:viewer": "VITE_TARGET=viewer vite --port 5174 --open /viewer.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
