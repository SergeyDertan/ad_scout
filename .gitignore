node_modules/
data/
logs/
backups/
data-dump/
.env
*.log
dist/
web/dist/
.DS_Store

# Credentials — never committed.
#   adscout-backup.json          where provision-backup-sa.sh drops the mirror's
#                                key; the archives it unlocks hold every
#                                mailbox's OAuth refresh token
#   client_secret.json           the Gmail OAuth client
#   firebase-service-account.json  the older, project-wide key it replaced
# The wildcard is the safety net: a key downloaded under whatever name the
# console gave it is the likeliest way one of these gets staged by accident.
adscout-backup.json
client_secret.json
firebase-service-account.json
*-service-account*.json
web/.env.local

# IDE / editor
.idea/
*.iml

# Local agent settings
.claude/settings.local.json

# Firebase deploy cache — regenerated on every deploy (`firebase deploy --only
# storage`, now the only thing this project deploys to Firebase)
.firebase/

# Archives
*.zip
