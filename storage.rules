rules_version = '2';

// Deny every browser client, everywhere in the bucket.
//
// Nothing in the front end reads Cloud Storage any more. The read-only viewer
// that used to — signed in, allowlisted, served the published price snapshot —
// is gone; the console reads this project's own /api instead, gated by the
// ID-token allowlist in src/server/auth.ts. A read rule kept "just in case"
// would be an opening with nothing on the other side of it.
//
// What DOES live in this bucket is the offsite mirror of the hourly database
// backups (src/services/backup.ts), and those archives carry
// `Account.oauthTokens.refreshToken` for every mailbox — unencrypted. This file
// is the only thing standing between them and anyone who guesses an object
// path. Do not add a read rule here for a debugging session.
//
// The backup writer is unaffected: it runs server-side with a service-account
// key, and the Admin SDK bypasses these rules entirely. That account holds
// `roles/storage.objectAdmin` on this one bucket and nothing else — see
// deploy/provision-backup-sa.sh.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
