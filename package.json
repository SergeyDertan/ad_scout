{
  "name": "adscout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "demo": "tsx src/index.ts",
    "serve": "tsx src/serve.ts",
    "dev": "tsx watch src/serve.ts",
    "web:build": "pnpm --filter adscout-web build",
    "web:dev": "pnpm --filter adscout-web dev",
    "web:typecheck": "pnpm --filter adscout-web typecheck",
    "build": "pnpm --filter adscout-web build",
    "dev:all": "concurrently -n server,web -c blue,green 'pnpm dev' 'pnpm web:dev'"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.1",
    "@types/pouchdb": "^6.4.2",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "imapflow": "^1.4.2",
    "mailparser": "^3.9.11",
    "node-html-markdown": "^2.0.0",
    "nodemailer": "^9.0.1",
    "pouchdb": "^9.0.0"
  }
}
